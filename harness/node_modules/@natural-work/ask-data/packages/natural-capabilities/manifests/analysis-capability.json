{
  "contract_version": 1,
  "id": "analysis",
  "version": "2.1.0",
  "title": "分析技能",
  "operations": [
    {
      "name": "method",
      "title": "执行完整分析方法",
      "description": "执行analysis_list公布的42类非空间方法及当前项目发布的custom技能。读取保留数据计算，不返回原始明细；缺输入拒绝，预测提供回测和区间，驱动分析不证明因果。",
      "input_schema": {
        "$defs": {
          "Constraint": {
            "additionalProperties": false,
            "properties": {
              "coefficients": {
                "items": {
                  "type": "number"
                },
                "maxItems": 100,
                "minItems": 1,
                "title": "Coefficients",
                "type": "array"
              },
              "relation": {
                "default": "lte",
                "enum": [
                  "lte",
                  "eq"
                ],
                "title": "Relation",
                "type": "string"
              },
              "bound": {
                "title": "Bound",
                "type": "number"
              }
            },
            "required": [
              "coefficients",
              "bound"
            ],
            "title": "Constraint",
            "type": "object"
          },
          "Options": {
            "additionalProperties": false,
            "properties": {
              "threshold": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Threshold"
              },
              "benchmark": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Benchmark"
              },
              "target": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Target"
              },
              "top_n": {
                "default": 5,
                "maximum": 100,
                "minimum": 1,
                "title": "Top N",
                "type": "integer"
              },
              "window": {
                "default": 3,
                "maximum": 60,
                "minimum": 2,
                "title": "Window",
                "type": "integer"
              },
              "seasonal_period": {
                "default": 12,
                "maximum": 52,
                "minimum": 2,
                "title": "Seasonal Period",
                "type": "integer"
              },
              "clusters": {
                "default": 3,
                "maximum": 10,
                "minimum": 2,
                "title": "Clusters",
                "type": "integer"
              },
              "forecast_steps": {
                "default": 3,
                "maximum": 24,
                "minimum": 1,
                "title": "Forecast Steps",
                "type": "integer"
              },
              "forecast_model": {
                "default": "ets",
                "enum": [
                  "arima",
                  "ets",
                  "linear"
                ],
                "title": "Forecast Model",
                "type": "string"
              },
              "arima_order": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 3,
                "minItems": 3,
                "title": "Arima Order",
                "type": "array"
              },
              "weights": {
                "items": {
                  "type": "number"
                },
                "maxItems": 20,
                "title": "Weights",
                "type": "array"
              },
              "scenario_multiplier": {
                "default": 1.0,
                "title": "Scenario Multiplier",
                "type": "number"
              },
              "scenario_offset": {
                "default": 0.0,
                "title": "Scenario Offset",
                "type": "number"
              },
              "constraints": {
                "items": {
                  "$ref": "#/$defs/Constraint"
                },
                "maxItems": 100,
                "title": "Constraints",
                "type": "array"
              },
              "bounds": {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "maxItems": 100,
                "title": "Bounds",
                "type": "array"
              },
              "maximize": {
                "default": false,
                "title": "Maximize",
                "type": "boolean"
              }
            },
            "title": "Options",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "result_ref": {
            "title": "Result Ref",
            "type": "string"
          },
          "method_id": {
            "description": "analysis_list 中matrix.编号的42类方法，或custom.条目标识",
            "title": "Method Id",
            "type": "string"
          },
          "method_version": {
            "default": "1.0.0",
            "title": "Method Version",
            "type": "string"
          },
          "columns": {
            "description": "数值字段；回归首列为因变量，相关需两列，效率需产出和投入两列",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Columns",
            "type": "array"
          },
          "dimensions": {
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "title": "Dimensions",
            "type": "array"
          },
          "time_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time Column"
          },
          "comparison_result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Comparison Result Ref"
          },
          "options": {
            "$ref": "#/$defs/Options"
          }
        },
        "required": [
          "result_ref",
          "method_id"
        ],
        "title": "Method",
        "type": "object"
      },
      "permission": "data.read",
      "output_kind": "analysis.claims",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "default": "succeeded",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "artifact_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifact Ref"
          },
          "result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Ref"
          },
          "claims": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Claims",
            "type": "array"
          },
          "skills": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Skills"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "title": "Output",
        "type": "object"
      },
      "timeout_ms": 60000
    },
    {
      "name": "list",
      "title": "可用分析技能",
      "description": "获取版本化分析技能、必要条件与限制。",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "title": "ListSkills",
        "type": "object"
      },
      "permission": "data.read",
      "output_kind": "analysis.catalog",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "default": "succeeded",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "artifact_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifact Ref"
          },
          "result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Ref"
          },
          "claims": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Claims",
            "type": "array"
          },
          "skills": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Skills"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "title": "Output",
        "type": "object"
      },
      "timeout_ms": 45000
    },
    {
      "name": "compute",
      "title": "确定性计算",
      "description": "对data_report的完整事实计算同比/差额、排名、占比、阈值分支或复核。合计使用sum，部分合计以fact_ids明确选择；返回范围与事实引用。不得用心算代替；复核stated_value指差额。",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "result_ref": {
            "title": "Result Ref",
            "type": "string"
          },
          "operation": {
            "enum": [
              "period_compare",
              "share",
              "rank",
              "threshold_filter",
              "branch_compare",
              "reconcile",
              "month_over_month",
              "compare_values",
              "cumulative_share",
              "sum"
            ],
            "title": "Operation",
            "type": "string"
          },
          "fact_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fact Ids"
          },
          "sum_basis": {
            "default": "non_overlapping",
            "enum": [
              "non_overlapping",
              "category_occurrences"
            ],
            "title": "Sum Basis",
            "type": "string"
          },
          "baseline_fact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "compare_values或branch_compare的基期事实ID；分支比较使用本期减基期的差额，与threshold比较。",
            "title": "Baseline Fact Id"
          },
          "current_fact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "本期事实ID；两个ID必须同时提供，不能省略后心算差额。",
            "title": "Current Fact Id"
          },
          "baseline_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Baseline Period"
          },
          "current_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Current Period"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Threshold"
          },
          "comparison": {
            "default": "<",
            "enum": [
              "<",
              "<=",
              ">",
              ">=",
              "=="
            ],
            "title": "Comparison",
            "type": "string"
          },
          "stated_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stated Value"
          }
        },
        "required": [
          "result_ref",
          "operation"
        ],
        "title": "Compute",
        "type": "object"
      },
      "permission": "data.read",
      "output_kind": "analysis.claims",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "default": "succeeded",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "artifact_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifact Ref"
          },
          "result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Ref"
          },
          "claims": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Claims",
            "type": "array"
          },
          "skills": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Skills"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "title": "Output",
        "type": "object"
      },
      "timeout_ms": 45000
    },
    {
      "name": "run",
      "title": "执行分析技能",
      "description": "执行具名、版本化分析技能并产生可追溯结论。异常归因缺原因证据时仅完成异常识别。",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "result_ref": {
            "title": "Result Ref",
            "type": "string"
          },
          "skill_id": {
            "title": "Skill Id",
            "type": "string"
          },
          "version": {
            "default": "1.0.0",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "result_ref",
          "skill_id"
        ],
        "title": "Skill",
        "type": "object"
      },
      "permission": "data.read",
      "output_kind": "analysis.claims",
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "default": "succeeded",
            "enum": [
              "succeeded",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "artifact_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifact Ref"
          },
          "result_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Ref"
          },
          "claims": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Claims",
            "type": "array"
          },
          "skills": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Skills"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "title": "Output",
        "type": "object"
      },
      "timeout_ms": 45000
    }
  ]
}
